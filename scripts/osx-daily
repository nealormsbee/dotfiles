#!/bin/zsh

if [ "$1" = "--speak" ]; then
  doSpeak=true
else
  doSpeak=
fi

speak() {
    if [ $doSpeak ]; then
      say $1
    fi
}

# update om-my-zsh
echo "======================"
echo "| Updating oh-my-zsh |"
echo "======================"
speak "Updating Oh Em Zee"
ZSH="$HOME/.oh-my-zsh"
zsh "$ZSH/tools/upgrade.sh"

# initialize zinit for this shell
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"

# update zinit
echo "=================="
echo "| Updating zinit |"
echo "=================="
speak "Updating Zee Init"
zi self-update

# update zinit plugins
echo "=========================="
echo "| Updating zinit plugins |"
echo "=========================="
speak "Updating Zee Init Plugins"
zi update --parallel

# update rust install via rustup
echo "================="
echo "| Updating rust |"
echo "================="
speak "Updating Rust"
rustup update

# update homebrew
echo "============================="
echo "| Updating homebrew indexes |"
echo "============================="
speak "Updating homebrew indexes"
brew update

# upgrade packages
echo "========================================="
echo "| Upgrading homebrew non-cask packages |"
echo "========================================="
speak "Upgrading homebrew see el eye tools"
brew upgrade

# upgrade casks
echo "===================================="
echo "| Upgrading homebrew cask packages |"
echo "===================================="
speak "Upgrading homebrew casks"
brew upgrade --cask

# remove old package versions
echo "=========================================="
echo "| Removing old homebrew package versions |"
echo "=========================================="
speak "Removing old homebrew package versions"
brew cleanup

# restart background services
echo "================================"
echo "| Restarting homebrew services |"
echo "================================"
speak "Restarting homwbrew services"
brew services restart --all

# confirm system integrity
echo "======================="
echo "| Running brew doctor |"
echo "======================="
speak "Running brew doctor"
brew doctor
